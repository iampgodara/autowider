---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Autowider – Real Car Prices, Specs & Comparisons India">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm text-center">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-[#E63946] mb-4">
        ★ Astro 7 + Cloudflare Pages Engine Active
      </span>
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">
        Welcome to Auto<span class="text-[#E63946]">wider</span>.com
      </h1>
      <p class="text-slate-600 text-base max-w-2xl mx-auto mt-3">
        India's modern automotive portal. Compare cars, read real specs, check on-road prices, and stay ahead with breaking auto news.
      </p>

      <div class="flex justify-center gap-4 mt-6">
        <a href="/compare-cars" class="bg-[#E63946] hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-md shadow-red-500/20 text-sm">
          Launch Comparison Engine
        </a>
        <a href="/cars" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold px-6 py-3 rounded-xl transition text-sm">
          Browse All Cars
        </a>
      </div>
    </div>
  </main>
</Layout>
